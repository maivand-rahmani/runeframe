{
  "name": "runeframe",
  "version": "0.5.2",
  "description": "Build mouse-first terminal apps with Ink and React, with full keyboard support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maivand-rahmani/runeframe.git"
  },
  "private": false,
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental/index.d.ts",
      "import": "./dist/experimental/index.js"
    },
    "./windows-input": {
      "types": "./dist/windows-input.d.ts",
      "import": "./dist/windows-input.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "REPOSITORY_SETUP.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "ink": "^7.0.2",
    "react": "^19.2.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "build:native-windows": "node scripts/build-native-windows.mjs",
    "stage:native-windows": "node scripts/stage-native-windows.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src scripts",
    "test:scripts": "vitest run scripts",
    "test:integration:smoke": "vitest run --config vitest.integration.config.ts",
    "test:integration:full": "vitest run --config vitest.integration.config.ts --reporter verbose",
    "prepack": "npm run build && npm run stage:native-windows",
    "pack:check": "npm run build && npm run stage:native-windows && node scripts/pack-consumer-check.mjs",
    "test-app": "node scripts/test-app.mjs",
    "test-app:check": "node scripts/test-app.mjs --check",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "publish:release": "npm publish --access public",
    "publish:beta": "npm publish --tag beta --provenance --access public"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "ink": "^7.0.2",
    "ink-testing-library": "^4.0.0",
    "react": "^19.2.5",
    "strip-ansi": "^7.2.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
